<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="at.htl.zahlenratengui.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <Label fx:id="outputLabel"/>



    <TextField fx:id="inputfield"/>

    <Button fx:id="guessbutton" onAction="#onGuessButton" text="Take a Guess" />
   <Button fx:id="neuesspieelknopf" onAction="#neuesSpiel" text="Neues Spiel" />
   <Slider fx:id="slideLower" />
   <Slider fx:id="slideUpper"/>


</VBox>
